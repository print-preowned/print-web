---
alwaysApply: true
---
sellers:
  api: /sellers
  context: SELLER
  ui:
    - /seller
    - /seller/businesses
  copy: Storefront

  privileges:
    READ_SELLER:
      context: SELLER
    UPDATE_SELLER:
      context: SELLER
    DELETE_SELLER:
      context: SELLER
      owner_only: true

  invariants:
    - id: MDC-FE-SELLER-1
      assertion: seller_ui_requires_seller_context

    - id: MDC-FE-SELLER-2
      assertion: customer_store_url_is_stores_id

    - id: MDC-FE-SELLER-3
      assertion: one_membership_auto_switches

    - id: MDC-FE-SELLER-4
      assertion: multiple_memberships_require_seller_picker
