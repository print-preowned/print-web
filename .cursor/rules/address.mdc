---
alwaysApply: true
---
addresses:
  user_addresses:
    api: /addresses
    context: CUSTOMER
    ui:
      - /account/addresses
    copy: Address book / Saved addresses

    invariants:
      - id: MDC-FE-ADDRESS-1
        assertion: address_book_requires_customer_context

      - id: MDC-FE-ADDRESS-2
        assertion: delivery_phone_is_distinct_from_account_phone

  seller_locations:
    api: /seller-addresses
    context: SELLER
    ui:
      - /seller/account
    copy: Store locations

    privileges:
      READ_SELLER:
        context: SELLER
      UPDATE_SELLER:
        context: SELLER

    invariants:
      - id: MDC-FE-ADDRESS-3
        assertion: store_locations_require_seller_context

      - id: MDC-FE-ADDRESS-4
        assertion: location_mutations_require_update_seller

      - id: MDC-FE-ADDRESS-6
        assertion: at_most_one_pickup_location_per_seller

  checkout:
    ui:
      - /checkout
    requires:
      - fulfillment_type DELIVERY or PICKUP
      - shipping_address_id when DELIVERY
      - pickup_location_id when PICKUP
    pickup_read:
      - GET /sellers/{sellerId}/pickup-location
    invariants:
      - id: MDC-FE-ADDRESS-5
        assertion: checkout_requires_fulfillment_selection_for_active_mode

  order_fulfillment:
    display:
      - customer order detail
      - seller order detail
    source: seller_order.fulfillment_address
    pickup_statuses:
      - READY_FOR_PICKUP
      - PICKED_UP
