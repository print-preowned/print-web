---
alwaysApply: true
---
  variants:
    visibility:
      CUSTOMER:
        allowed:
          - READ_PUBLIC_VARIANTS
      SELLER:
        allowed:
          - READ_VARIANT
          - CREATE_VARIANT
          - UPDATE_VARIANT
          - DELETE_VARIANT

    privileges:
      READ_PUBLIC_VARIANTS:
        context: CUSTOMER

      READ_VARIANT:
        context: SELLER

      CREATE_VARIANT:
        context: SELLER

      UPDATE_VARIANT:
        context: SELLER

      DELETE_VARIANT:
        context: SELLER
        owner_only: true

    notes: >
      API paths use /variants. Seller workspace copy uses Inventory, not bibliographic work/publication terms.

    invariants:
      - id: MDC-VARIANT-1
        assertion: variants_are_seller_scoped

      - id: MDC-VARIANT-2
        assertion: variant_mutation_requires_seller_context
