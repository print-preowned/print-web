---
alwaysApply: true
---
  seller_inventory:
    visibility:
      SELLER:
        allowed:
          - READ_SELLER_INVENTORY
          - CREATE_SELLER_INVENTORY
          - UPDATE_SELLER_INVENTORY
          - DELETE_SELLER_INVENTORY

    notes: >
      Seller workspace copy uses Inventory. The sellable unit is a seller_inventory
      offer. Variant SKUs are retired.

    invariants:
      - id: MDC-INVENTORY-1
        assertion: offers_are_seller_scoped
