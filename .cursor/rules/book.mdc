---
alwaysApply: true
---
modules:
  books:
    visibility:
      CUSTOMER:
        allowed:
          - READ_PUBLIC_BOOK
        urls: /books
        api: GET /works
      SELLER:
        allowed:
          - READ_BOOK
        notes: Seller catalog search uses GET /works; publication lookup uses GET /publications; offers use SELLER_INVENTORY
      PLATFORM:
        allowed:
          - CREATE_BOOK
          - UPDATE_BOOK
          - DELETE_BOOK
        urls: [/admin/books, /admin/books/create, /admin/publishers, /admin/series]
        api: [/works, /publications]
        notes: >
          Admin create is /admin/books/create (work plus first publication).
          Edit on /admin/books manages work metadata, authors, genres, and
          additional publications via /works and /publications. Platform
          catalog authority is only MANAGE_BOOKS. GET /works returns a
          structured title; customer and admin cards use displayTitle.
          Embedded offer titles stay a string. A publication's isbn13
          is the indexed ISBN-13; other identifier schemes, the edition
          number, and the published date travel with the publication.
          The edition statement stays the edition field. The product form
          is paperback, hardcover, ebook, or audiobook. A publication
          stores a publisher and the imprint name from the title page.
          Publishers are managed at /admin/publishers. An imprint can be
          its own publisher, pointing at a parent house. Series are
          managed at /admin/series. A series spans works. A publication
          stores the series and its number in that series.

    privileges:
      READ_PUBLIC_BOOK:
        context: CUSTOMER
        description: Read public work catalog data
      READ_BOOK:
        context: SELLER
        description: Search global works and publications when onboarding inventory
      CREATE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations
      UPDATE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations
      DELETE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations

    invariants:
      - id: MDC-BOOK-1
        assertion: customer_books_urls_read_works_api
      - id: MDC-BOOK-2
        assertion: platform_catalog_mutations_use_works_and_publications
      - id: MDC-BOOK-3
        assertion: book_privileges_cover_works_publications_authors_genres_publishers_and_series
