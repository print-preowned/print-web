---
alwaysApply: true
---
modules:
  books:
    visibility:
      CUSTOMER:
        allowed:
          - READ_PUBLIC_BOOK
      SELLER:
        allowed:
          - READ_BOOK
          - CREATE_BOOK
          - UPDATE_BOOK
          - DELETE_BOOK

    privileges:
      READ_PUBLIC_BOOK:
        context: CUSTOMER
        description: Read public book catalog data

      READ_BOOK:
        context: SELLER
        description: Read book data within a storefront

      CREATE_BOOK:
        context: SELLER

      UPDATE_BOOK:
        context: SELLER

      DELETE_BOOK:
        context: SELLER
        owner_only: true

    invariants:
      - id: MDC-BOOK-1
        assertion: book_visibility_is_public_or_seller_scoped

      - id: MDC-BOOK-2
        assertion: deleting_book_requires_owner
