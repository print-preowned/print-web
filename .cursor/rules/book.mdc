---
alwaysApply: true
---
modules:
  books:
    visibility:
      CUSTOMER:
        allowed:
          - READ_PUBLIC_BOOK
        urls: /books
        api: GET /works
      SELLER:
        allowed:
          - READ_BOOK
        notes: Seller catalog search uses GET /works; publication lookup uses GET /publications; offers use SELLER_INVENTORY
      PLATFORM:
        allowed:
          - CREATE_BOOK
          - UPDATE_BOOK
          - DELETE_BOOK
        urls: /admin/books
        api: [/works, /publications]

    privileges:
      READ_PUBLIC_BOOK:
        context: CUSTOMER
        description: Read public work catalog data
      READ_BOOK:
        context: SELLER
        description: Search global works and publications when onboarding inventory
      CREATE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations
      UPDATE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations
      DELETE_BOOK:
        context: PLATFORM
        notes: Covers work and publication mutations

    invariants:
      - id: MDC-BOOK-1
        assertion: customer_books_urls_read_works_api
      - id: MDC-BOOK-2
        assertion: platform_catalog_mutations_use_works_and_publications
      - id: MDC-BOOK-3
        assertion: book_privileges_cover_works_and_publications
