---
alwaysApply: true
---
payout_accounts:
  api: /payout-accounts
  context: SELLER
  ui:
    - /seller/account
  copy: Payout account

  privileges:
    READ_SELLER:
      context: SELLER
    UPDATE_SELLER:
      context: SELLER

  invariants:
    - id: MDC-FE-PAYOUT-1
      assertion: payout_settings_require_business_context

    - id: MDC-FE-PAYOUT-2
      assertion: payout_mutations_require_update_business

    - id: MDC-FE-PAYOUT-3
      assertion: psa_tokens_not_shown_to_customers
